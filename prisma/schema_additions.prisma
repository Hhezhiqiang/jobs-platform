
// ==================== 用户求职偏好 ====================

model UserJobPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cultureTags     String[] @default([])  // 期望的公司文化标签
  salaryMin       Int?     // 最低期望薪资
  salaryMax       Int?     // 最高期望薪资
  employmentTypes String[] @default([])  // 期望的工作类型
  locations       String[] @default([])  // 期望的工作地点
  remotePreference String?  // 远程偏好：FULL_REMOTE | HYBRID | ONSITE | ANY
  experienceLevel String?  // 期望的经验级别：ENTRY | MID | SENIOR | EXECUTIVE
  
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  @@index([userId])
  @@map("user_job_preferences")
}

// ==================== 用户求职状态 ====================

enum JobSeekingStatusEnum {
  OPEN      // 积极求职中
  PASSIVE   // 被动看看
  CLOSED    // 暂不求职
}

enum JobSeekingPrivacy {
  PUBLIC     // 公开
  FOLLOWERS  // 仅关注者
  CIRCLES    // 仅圈子
  PRIVATE    // 私密
}

model JobSeekingStatus {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            users              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status          JobSeekingStatusEnum @default(CLOSED)
  expectTags      String[]           @default([])  // 期望标签
  expectSalary    String?            // 期望薪资范围文本
  bio             String?            // 求职简介
  privacy         JobSeekingPrivacy  @default(CIRCLES)
  
  viewCount       Int                @default(0)  // 被查看次数
  recommendCount  Int                @default(0)  // 被推荐次数
  
  lastActiveAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  @@index([userId])
  @@index([status, privacy])
  @@map("job_seeking_status")
}

// ==================== 内推/推荐记录 ====================

enum RecommendationStatus {
  PENDING    // 待处理
  ACCEPTED   // 已接受
  REJECTED   // 已拒绝
  COMPLETED  // 已完成
}

model JobRecommendation {
  id          String               @id @default(cuid())
  
  // 推荐人（HR/员工）
  senderId    String
  sender      users                @relation("RecommendationsSent", fields: [senderId], references: [id], onDelete: Cascade)
  
  // 被推荐人（求职者）
  receiverId  String
  receiver    users                @relation("RecommendationsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  
  // 关联职位
  jobId       String
  job         jobs                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  // 关联故事（如果是通过故事发起的邀请）
  storyId     String?
  
  status      RecommendationStatus @default(PENDING)
  message     String?              // 推荐留言
  
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  respondedAt DateTime?            // 响应时间
  
  @@unique([senderId, receiverId, jobId])
  @@index([receiverId, status])
  @@index([senderId, createdAt])
  @@map("job_recommendations")
}

// ==================== 故事评论 ====================

model StoryComment {
  id        String   @id @default(cuid())
  storyId   String
  story     CareerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  authorId  String
  author    users  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([storyId, createdAt])
  @@index([authorId])
  @@map("story_comments")
}
