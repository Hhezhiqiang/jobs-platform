generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  password     String
  role         UserRole         @default(USER)
  avatar       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  phone        String?
  status       UserStatus       @default(ACTIVE)
  ads          Ad[]
  applications JobApplication[]
  jobs         Job[]
  pages        Page[]
  resumes      Resume[]
  sessions     Session[]
  profile      UserProfile?

  @@map("users")
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  gender         String?
  birthday       DateTime?
  location       String?
  workExperience Json?
  education      Json?
  skills         String[]
  bio            String?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Resume {
  id           String           @id @default(cuid())
  userId       String
  name         String
  fileUrl      String
  fileType     String
  fileSize     Int
  isDefault    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model JobApplication {
  id           String            @id @default(cuid())
  jobId        String
  userId       String
  resumeId     String?
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  appliedAt    DateTime          @default(now())
  viewedAt     DateTime?
  respondedAt  DateTime?
  withdrewAt   DateTime?
  responseType String?
  responseNote String?
  job          Job               @relation(fields: [jobId], references: [id])
  resume       Resume?           @relation(fields: [resumeId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([jobId, status])
  @@map("job_applications")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Company {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logo            String?
  website         String?
  description     String?
  industry        String?
  size            String?
  location        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaTitle       String?
  metaDescription String?
  jobs            Job[]

  @@map("companies")
}

model Job {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  title                  String
  description            String
  requirements           String?
  benefits               String?
  employmentType         EmploymentType   @default(FULL_TIME)
  experience             ExperienceLevel  @default(MID)
  salaryMin              Int?
  salaryMax              Int?
  salaryCurrency         String           @default("CNY")
  salaryPeriod           String           @default("YEAR")
  location               String
  city                   String?
  country                String           @default("CN")
  isRemote               Boolean          @default(false)
  isHybrid               Boolean          @default(false)
  applyUrl               String
  status                 JobStatus        @default(ACTIVE)
  isFeatured             Boolean          @default(false)
  viewCount              Int              @default(0)
  datePosted             DateTime         @default(now())
  validThrough           DateTime?
  metaTitle              String?
  metaDescription        String?
  keywords               String[]
  imageUrl               String?
  schemaOrganizationName String?
  schemaOrganizationLogo String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  companyId              String
  authorId               String
  applications           JobApplication[]
  author                 User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, datePosted])
  @@index([city, status])
  @@index([employmentType, status])
  @@index([isFeatured, status])
  @@map("jobs")
}

model AdPosition {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  width       Int?
  height      Int?
  maxAds      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ads         Ad[]

  @@map("ad_positions")
}

model Ad {
  id          String     @id @default(cuid())
  title       String
  type        AdType     @default(IMAGE)
  imageUrl    String?
  linkUrl     String
  textContent String?
  altText     String?
  status      AdStatus   @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  clickCount  Int        @default(0)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positionId  String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  position    AdPosition @relation(fields: [positionId], references: [id])

  @@map("ads")
}

model SEOSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  content         String
  excerpt         String?
  type            PageType   @default(PAGE)
  status          PageStatus @default(PUBLISHED)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  featuredImage   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  authorId        String
  viewCount       Int        @default(0)
  author          User       @relation(fields: [authorId], references: [id])

  @@index([type, status])
  @@index([slug, status])
  @@map("pages")
}

enum UserRole {
  ADMIN
  USER
  COMPANY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  INTERVIEW
  REJECTED
  OFFER
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum AdType {
  IMAGE
  TEXT
  CAROUSEL
}

enum AdStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PageType {
  PAGE
  BLOG
  FAQ
  GUIDE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
