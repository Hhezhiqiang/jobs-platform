generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  password      String
  role          UserRole         @default(USER)
  avatar        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  phone         String?
  status        UserStatus       @default(ACTIVE)
  ads           Ad[]
  companies     CompanyMember[]
  favorites     Favorite[]
  applications  JobApplication[]
  jobs          Job[]
  notifications Notification[]
  pages         Page[]
  resumes       Resume[]
  sessions      Session[]
  profile       UserProfile?

  @@map("users")
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  gender         String?
  birthday       DateTime?
  location       String?
  workExperience Json?
  education      Json?
  skills         String[]
  bio            String?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Resume {
  id           String           @id @default(cuid())
  userId       String
  name         String
  fileUrl      String
  fileType     String
  fileSize     Int
  isDefault    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model JobApplication {
  id           String            @id @default(cuid())
  jobId        String
  userId       String
  resumeId     String?
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  appliedAt    DateTime          @default(now())
  viewedAt     DateTime?
  respondedAt  DateTime?
  withdrewAt   DateTime?
  responseType String?
  responseNote String?
  job          Job               @relation(fields: [jobId], references: [id])
  resume       Resume?           @relation(fields: [resumeId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([jobId, status])
  @@map("job_applications")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Company {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  logo               String?
  website            String?
  description        String?
  industry           String?
  size               String?
  location           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  metaTitle          String?
  metaDescription    String?
  businessLicense    String?
  contactEmail       String?
  contactPhone       String?
  creditCode         String?         @unique
  legalPersonName    String?
  rejectionReason    String?
  verificationStatus CompanyStatus   @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  members            CompanyMember[]
  jobs               Job[]

  @@map("companies")
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(ADMIN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model Job {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  title                  String
  description            String
  requirements           String?
  benefits               String?
  employmentType         EmploymentType   @default(FULL_TIME)
  experience             ExperienceLevel  @default(MID)
  salaryMin              Int?
  salaryMax              Int?
  salaryCurrency         String           @default("CNY")
  salaryPeriod           String           @default("YEAR")
  location               String
  city                   String?
  country                String           @default("CN")
  isRemote               Boolean          @default(false)
  isHybrid               Boolean          @default(false)
  applyUrl               String
  status                 JobStatus        @default(ACTIVE)
  isFeatured             Boolean          @default(false)
  viewCount              Int              @default(0)
  datePosted             DateTime         @default(now())
  validThrough           DateTime?
  metaTitle              String?
  metaDescription        String?
  keywords               String[]
  imageUrl               String?
  schemaOrganizationName String?
  schemaOrganizationLogo String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  companyId              String
  authorId               String
  favorites              Favorite[]
  applications           JobApplication[]
  author                 User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, datePosted])
  @@index([city, status])
  @@index([employmentType, status])
  @@index([isFeatured, status])
  @@map("jobs")
}

model AdPosition {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  width       Int?
  height      Int?
  maxAds      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ads         Ad[]

  @@map("ad_positions")
}

model Ad {
  id          String     @id @default(cuid())
  title       String
  type        AdType     @default(IMAGE)
  imageUrl    String?
  linkUrl     String
  textContent String?
  altText     String?
  status      AdStatus   @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  clickCount  Int        @default(0)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positionId  String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  position    AdPosition @relation(fields: [positionId], references: [id])

  @@map("ads")
}

model SEOSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  content         String
  excerpt         String?
  type            PageType   @default(PAGE)
  status          PageStatus @default(PUBLISHED)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  featuredImage   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  authorId        String
  viewCount       Int        @default(0)
  author          User       @relation(fields: [authorId], references: [id])
  keywordsFrom    KeywordMonitor[] @relation("KeywordToPage")

  @@index([type, status])
  @@index([slug, status])
  @@map("pages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
  @@map("favorites")
}

model SearchQuery {
  id           String   @id @default(cuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearched DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([count])
  @@index([lastSearched])
  @@map("search_queries")
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanyMemberRole {
  ADMIN
  RECRUITER
  VIEWER
}

enum UserRole {
  ADMIN
  USER
  COMPANY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  PENDING
  VIEWED
  INTERVIEW
  REJECTED
  OFFER
  WITHDRAWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum AdType {
  IMAGE
  TEXT
  CAROUSEL
}

enum AdStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PageType {
  PAGE
  BLOG
  FAQ
  GUIDE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  APPLICATION_UPDATE
  SYSTEM
  JOB_ALERT
  INTERVIEW_INVITE
  OFFER_RECEIVED
}

// 页面访问统计模型 - 真实PV数据
model PageView {
  id        String   @id @default(cuid())
  path      String   // 访问路径
  userAgent String?  // 浏览器User-Agent
  ip        String?  // IP地址（哈希处理）
  referrer  String?  // 来源页面
  country   String?  // 国家
  city      String?  // 城市
  userId    String?  // 登录用户ID
  sessionId String   // 会话ID，用于计算UV
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@map("page_views")
}

// 关键词监控系统
model KeywordMonitor {
  id           String   @id @default(cuid())
  keyword      String   // 原始关键词/话题
  normalized   String   // 规范化关键词（去空格、小写）
  language     String   @default("zh") // zh / en / ja
  source       String   // google_trends / zhihu / reddit / weibo / news / manual
  sourceUrl    String?  // 来源链接（如果有）
  trendScore   Float    @default(0) // 趋势得分 0-100
  searchVolume Int?     // 估算搜索量（绝对值，可选）
  hotLevel     Int      @default(1) // 1-5 热度分级
  category     String   @default("HOLD") // PRIMARY / TRAFFIC / JUNK / HOLD
  intent       String   @default("UNKNOWN") // INFORMATIONAL / NAVIGATIONAL / TRANSACTIONAL / UNKNOWN
  status       String   @default("PENDING") // PENDING / APPROVED / REJECTED / PUBLISHED / ARCHIVED
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt
  metadata     Json?    // 原始API返回的附加数据

  archives     KeywordArchive[]
  seoPlans     SEOPlan[]
  pages        Page[]   @relation("KeywordToPage")

  @@index([normalized, source])
  @@index([category, status])
  @@index([trendScore])
  @@index([lastSeenAt])
  @@index([status, firstSeenAt])
  @@map("keyword_monitors")
}

// 关键词素材归档
model KeywordArchive {
  id               String         @id @default(cuid())
  monitorId        String
  monitor          KeywordMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  contentType      String         // SERP_SUMMARY / REDDIT_POST / ZHIHU_ANSWER / NEWS_ARTICLE / PERPLEXITY_QA / JOB_DATA
  contentUrl       String?        // 原始URL
  contentTitle     String?        // 标题
  contentBody      String         @db.Text // 内容体
  fetchedAt        DateTime       @default(now())
  relevanceScore   Float?         // AI评估的相关性 0-1
  usedInPlan       Boolean        @default(false) // 是否已被SEO方案引用

  @@index([monitorId, contentType])
  @@index([usedInPlan])
  @@map("keyword_archives")
}

// SEO 方案生成结果
model SEOPlan {
  id              String         @id @default(cuid())
  monitorId       String
  monitor         KeywordMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  pageType        String         // BLOG / TOPIC / FAQ / SALARY_REPORT
  title           String         // 建议页面标题
  h1              String         // 建议H1
  metaDesc        String         // 建议Meta Description
  keywords        String[]       // 建议关键词数组
  outline         Json           // 文章/页面大纲（结构化JSON）
  targetUrl       String?        // 建议发布URL slug
  internalLinks   Json?          // 建议内链 [{text, url}]
  contentMarkdown String?        @db.Text // 生成的完整Markdown内容（可选）
  status          String         @default("PENDING") // PENDING / APPROVED / REJECTED / PUBLISHED
  generatedAt     DateTime       @default(now())
  generatedBy     String         // 模型标识，如 "gpt-4o-2026-04"
  approvedAt      DateTime?      // 审批通过时间
  approvedBy      String?        // 审批人ID
  publishedAt     DateTime?      // 发布时间
  publishUrl      String?        // 最终发布URL
  publishJobId    String?        // 关联的异步任务ID

  @@index([monitorId, pageType])
  @@index([status])
  @@index([publishedAt])
  @@map("seo_plans")
}

// 关键词与已发布内容的多对多关联
model KeywordToPage {
  A        String @map("keyword_id")
  B        String @map("page_id")

  @@unique([A, B])
  @@index([B])
  @@map("_keyword_to_page")
}
