generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  password      String
  role          UserRole         @default(USER)
  avatar        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  phone         String?
  status        UserStatus       @default(ACTIVE)
  ads           Ad[]
  applications  JobApplication[]
  jobs          Job[]
  pages         Page[]
  resumes       Resume[]
  sessions      Session[]
  profile       UserProfile?
  notifications Notification[]
  companies     CompanyMember[]  // 关联的企业
  favorites     Favorite[]

  @@map("users")
}

model UserProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  gender         String?
  birthday       DateTime?
  location       String?
  workExperience Json?
  education      Json?
  skills         String[]
  bio            String?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Resume {
  id           String           @id @default(cuid())
  userId       String
  name         String
  fileUrl      String
  fileType     String
  fileSize     Int
  isDefault    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model JobApplication {
  id           String            @id @default(cuid())
  jobId        String
  userId       String
  resumeId     String?
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  appliedAt    DateTime          @default(now())
  viewedAt     DateTime?
  respondedAt  DateTime?
  withdrewAt   DateTime?
  responseType String?
  responseNote String?
  job          Job               @relation(fields: [jobId], references: [id])
  resume       Resume?           @relation(fields: [resumeId], references: [id])
  user         User              @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([jobId, status])
  @@map("job_applications")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Company {
  id                  String        @id @default(cuid())
  name                String
  slug                String        @unique
  logo                String?
  website             String?
  description         String?
  industry            String?
  size                String?
  location            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  metaTitle           String?
  metaDescription     String?
  
  // 企业认证相关字段
  creditCode          String?       @unique // 统一社会信用代码
  businessLicense     String?       // 营业执照图片URL
  legalPersonName     String?       // 法人姓名
  contactPhone        String?       // 联系电话
  contactEmail        String?       // 联系邮箱
  verificationStatus  CompanyStatus @default(PENDING) // 认证状态
  verifiedAt          DateTime?     // 认证通过时间
  verifiedBy          String?       // 审核人ID
  rejectionReason     String?       // 拒绝原因
  
  // 关联
  jobs                Job[]
  members             CompanyMember[]
  
  @@map("companies")
}

// 企业成员关联表
model CompanyMember {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(ADMIN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

enum CompanyStatus {
  PENDING   // 待审核
  APPROVED  // 已通过
  REJECTED  // 已拒绝
  SUSPENDED // 已暂停
}

enum CompanyMemberRole {
  ADMIN     // 管理员
  RECRUITER // 招聘专员
  VIEWER    // 只读成员
}

model Job {
  id                     String           @id @default(cuid())
  slug                   String           @unique
  title                  String
  description            String
  requirements           String?
  benefits               String?
  employmentType         EmploymentType   @default(FULL_TIME)
  experience             ExperienceLevel  @default(MID)
  salaryMin              Int?
  salaryMax              Int?
  salaryCurrency         String           @default("CNY")
  salaryPeriod           String           @default("YEAR")
  location               String
  city                   String?
  country                String           @default("CN")
  isRemote               Boolean          @default(false)
  isHybrid               Boolean          @default(false)
  applyUrl               String
  status                 JobStatus        @default(ACTIVE)
  isFeatured             Boolean          @default(false)
  viewCount              Int              @default(0)
  datePosted             DateTime         @default(now())
  validThrough           DateTime?
  metaTitle              String?
  metaDescription        String?
  keywords               String[]
  imageUrl               String?
  schemaOrganizationName String?
  schemaOrganizationLogo String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  companyId              String
  authorId               String
  applications           JobApplication[]
  author                 User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  favorites              Favorite[]

  @@index([status, datePosted])
  @@index([city, status])
  @@index([employmentType, status])
  @@index([isFeatured, status])
  @@map("jobs")
}

model AdPosition {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  width       Int?
  height      Int?
  maxAds      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ads         Ad[]

  @@map("ad_positions")
}

model Ad {
  id          String     @id @default(cuid())
  title       String
  type        AdType     @default(IMAGE)
  imageUrl    String?
  linkUrl     String
  textContent String?
  altText     String?
  status      AdStatus   @default(PENDING)
  startDate   DateTime?
  endDate     DateTime?
  clickCount  Int        @default(0)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positionId  String
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  position    AdPosition @relation(fields: [positionId], references: [id])

  @@map("ads")
}

model SEOSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
}

model Page {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  content         String
  excerpt         String?
  type            PageType   @default(PAGE)
  status          PageStatus @default(PUBLISHED)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  featuredImage   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  authorId        String
  viewCount       Int        @default(0)
  author          User       @relation(fields: [authorId], references: [id])

  @@index([type, status])
  @@index([slug, status])
  @@map("pages")
}

enum UserRole {
  ADMIN
  USER
  COMPANY
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ApplicationStatus {
  PENDING   // 待处理
  VIEWED    // 已查看
  INTERVIEW // 面试
  REJECTED  // 拒绝
  OFFER     // 录用
  WITHDRAWN // 已撤回
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum AdType {
  IMAGE
  TEXT
  CAROUSEL
}

enum AdStatus {
  PENDING
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PageType {
  PAGE
  BLOG
  FAQ
  GUIDE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  metadata  Json?            // 存储额外信息如 jobId, applicationId 等
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
  @@map("favorites")
}

model SearchQuery {
  id          String   @id @default(cuid())
  query       String
  count       Int      @default(1)
  lastSearched DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([count])
  @@index([lastSearched])
  @@unique([query])
  @@map("search_queries")
}

enum NotificationType {
  APPLICATION_UPDATE
  SYSTEM
  JOB_ALERT
  INTERVIEW_INVITE
  OFFER_RECEIVED
}
