generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model keyword_to_page {
  keyword_id String
  page_id    String

  @@unique([keyword_id, page_id])
  @@index([page_id])
  @@map("_keyword_to_page")
}

model ad_positions {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  width       Int?
  height      Int?
  maxAds      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ads         ads[]
}

model ads {
  id           String       @id @default(uuid())
  title        String
  type         AdType       @default(IMAGE)
  imageUrl     String?
  linkUrl      String
  textContent  String?
  altText      String?
  status       AdStatus     @default(PENDING)
  startDate    DateTime?
  endDate      DateTime?
  clickCount   Int          @default(0)
  viewCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  positionId   String
  authorId     String
  users        users        @relation(fields: [authorId], references: [id])
  ad_positions ad_positions @relation(fields: [positionId], references: [id])
}

model balance_transactions {
  id                    String                 @id @default(uuid())
  userId                String
  type                  TransactionType
  amount                Decimal                @db.Decimal(18, 8)
  balanceAfter          Decimal                @db.Decimal(18, 8)
  description           String?
  orderId               String?                @unique
  createdAt             DateTime               @default(now())
  contact_unlock_orders contact_unlock_orders? @relation(fields: [orderId], references: [id])
  users                 users                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId, createdAt])
}

model commission_adjustments {
  id                 String             @id @default(uuid())
  commissionRecordId String
  promoterId         String
  amount             Decimal            @db.Decimal(18, 8)
  reason             String
  type               AdjustmentType     @default(REFUND)
  createdAt          DateTime           @default(now())
  commission_records commission_records @relation(fields: [commissionRecordId], references: [id], onDelete: Cascade)
  promoters          promoters          @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, createdAt])
}

model commission_records {
  id                     String                   @id @default(uuid())
  orderId                String                   @unique
  promoterId             String
  linkId                 String
  userId                 String
  orderAmount            Decimal                  @db.Decimal(18, 8)
  rate                   Decimal                  @db.Decimal(5, 2)
  commissionAmount       Decimal                  @db.Decimal(18, 8)
  status                 CommissionStatus         @default(FROZEN)
  frozenAt               DateTime                 @default(now())
  availableAt            DateTime?
  settledAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  commission_adjustments commission_adjustments[]
  promoter_links         promoter_links           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contact_unlock_orders  contact_unlock_orders    @relation(fields: [orderId], references: [id])
  promoters              promoters                @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([availableAt, status])
  @@index([promoterId, status])
}

model companies {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  logo               String?
  website            String?
  description        String?
  industry           String?
  size               String?
  location           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  metaTitle          String?
  metaDescription    String?
  businessLicense    String?
  contactEmail       String?
  contactPhone       String?
  creditCode         String?             @unique
  legalPersonName    String?
  rejectionReason    String?
  verificationStatus CompanyStatus       @default(PENDING)
  verifiedAt         DateTime?
  verifiedBy         String?
  descriptionEn      String?
  metaDescriptionEn  String?
  metaTitleEn        String?
  nameEn             String?
  cultureTags        String[]            @default([])
  careerStories      CareerStory[]
  CompanyCultureTag  CompanyCultureTag[]
  company_members    company_members[]
  jobs               jobs[]

  @@index([verificationStatus])
  @@index([slug, verificationStatus])
}

model company_members {
  id        String            @id @default(uuid())
  companyId String
  userId    String
  role      CompanyMemberRole @default(ADMIN)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  companies companies         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model contact_unlock_orders {
  id                   String                @id @default(uuid())
  userId               String
  jobId                String
  amount               Decimal               @db.Decimal(18, 8)
  status               OrderStatus           @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  balance_transactions balance_transactions?
  commission_records   commission_records?
  jobs                 jobs                  @relation(fields: [jobId], references: [id])
  users                users                 @relation(fields: [userId], references: [id])

  @@index([jobId])
  @@index([status, createdAt])
  @@index([userId, status])
}

model favorites {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  jobs      jobs     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId, createdAt])
}

model job_applications {
  id           String            @id @default(uuid())
  jobId        String
  userId       String?
  guestEmail   String?
  guestName    String?
  isLinked     Boolean           @default(false)
  resumeId     String?
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  appliedAt    DateTime          @default(now())
  viewedAt     DateTime?
  respondedAt  DateTime?
  withdrewAt   DateTime?
  responseType String?
  responseNote String?
  jobs         jobs              @relation(fields: [jobId], references: [id])
  resumes      resumes?          @relation(fields: [resumeId], references: [id])
  users        users?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([userId, status])
  @@index([status])
  @@index([guestEmail])
}

model jobs {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  title                  String
  description            String
  requirements           String?
  benefits               String?
  employmentType         EmploymentType          @default(FULL_TIME)
  experience             ExperienceLevel         @default(MID)
  salaryMin              Int?
  salaryMax              Int?
  salaryCurrency         String                  @default("CNY")
  salaryPeriod           String                  @default("YEAR")
  location               String
  city                   String?
  country                String                  @default("CN")
  isRemote               Boolean                 @default(false)
  isHybrid               Boolean                 @default(false)
  applyUrl               String
  status                 JobStatus               @default(ACTIVE)
  isFeatured             Boolean                 @default(false)
  viewCount              Int                     @default(0)
  datePosted             DateTime                @default(now())
  validThrough           DateTime?
  metaTitle              String?
  metaDescription        String?
  keywords               String[]
  imageUrl               String?
  schemaOrganizationName String?
  schemaOrganizationLogo String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  companyId              String
  authorId               String
  benefitsEn             String?
  descriptionEn          String?
  metaDescriptionEn      String?
  metaTitleEn            String?
  requirementsEn         String?
  titleEn                String?
  contact_unlock_orders  contact_unlock_orders[]
  favorites              favorites[]
  job_applications       job_applications[]
  jobRecommendations     JobRecommendation[]
  users                  users                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companies              companies               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([city, status])
  @@index([employmentType, status])
  @@index([isFeatured, status])
  @@index([status, datePosted])
  @@index([status, createdAt])
  @@index([country, status])
  @@index([companyId, status])
}

model keyword_archives {
  id               String           @id @default(uuid())
  monitorId        String
  contentType      String
  contentUrl       String?
  contentTitle     String?
  contentBody      String
  fetchedAt        DateTime         @default(now())
  relevanceScore   Float?
  usedInPlan       Boolean          @default(false)
  keyword_monitors keyword_monitors @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, contentType])
  @@index([usedInPlan])
}

model keyword_monitors {
  id               String             @id @default(uuid())
  keyword          String
  normalized       String
  language         String             @default("zh")
  source           String
  sourceUrl        String?
  trendScore       Float              @default(0)
  searchVolume     Int?
  hotLevel         Int                @default(1)
  category         String             @default("HOLD")
  intent           String             @default("UNKNOWN")
  status           String             @default("PENDING")
  firstSeenAt      DateTime           @default(now())
  lastSeenAt       DateTime
  metadata         Json?
  keyword_archives keyword_archives[]
  seo_plans        seo_plans[]
  pages            pages[]            @relation("KeywordToPage")

  @@index([category, status])
  @@index([lastSeenAt])
  @@index([normalized, source])
  @@index([status, firstSeenAt])
  @@index([trendScore])
}

model notifications {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  users     users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model page_views {
  id        String   @id @default(uuid())
  path      String
  userAgent String?
  ip        String?
  referrer  String?
  country   String?
  city      String?
  userId    String?
  sessionId String
  duration  Int?     // 页面停留时长（秒）
  eventType String?  // page_view / click / search / scroll
  eventData Json?    // 事件详情 {target, keyword, depth, ...}
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
}

model pages {
  id                String             @id @default(uuid())
  slug              String             @unique
  title             String
  content           String
  excerpt           String?
  type              PageType           @default(PAGE)
  status            PageStatus         @default(PUBLISHED)
  metaTitle         String?
  metaDescription   String?
  keywords          String[]
  featuredImage     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  authorId          String
  viewCount         Int                @default(0)
  contentEn         String?
  excerptEn         String?
  metaDescriptionEn String?
  metaTitleEn       String?
  titleEn           String?
  users             users              @relation(fields: [authorId], references: [id])
  keyword_monitors  keyword_monitors[] @relation("KeywordToPage")

  @@index([slug, status])
  @@index([type, status])
  @@index([status, createdAt])
  @@index([authorId, createdAt])
}

model promoter_links {
  id                 String               @id @default(uuid())
  promoterId         String
  name               String
  code               String               @unique
  customRate         Decimal?             @db.Decimal(5, 2)
  landingPage        String               @default("/")
  clickCount         Int                  @default(0)
  registerCount      Int                  @default(0)
  orderCount         Int                  @default(0)
  gmv                Decimal              @default(0.0) @db.Decimal(18, 8)
  status             LinkStatus           @default(ACTIVE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  commission_records commission_records[]
  promoters          promoters            @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  user_referrals     user_referrals[]

  @@index([code])
  @@index([promoterId, status])
}

model promoters {
  id                     String                   @id @default(uuid())
  userId                 String?                  @unique
  name                   String
  email                  String                   @unique
  phone                  String?
  walletAddress          String?
  defaultRate            Decimal                  @default(30.0) @db.Decimal(5, 2)
  status                 PromoterStatus           @default(PENDING)
  availableBalance       Decimal                  @default(0.0) @db.Decimal(18, 8)
  frozenBalance          Decimal                  @default(0.0) @db.Decimal(18, 8)
  withdrawnBalance       Decimal                  @default(0.0) @db.Decimal(18, 8)
  totalEarnings          Decimal                  @default(0.0) @db.Decimal(18, 8)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  commission_adjustments commission_adjustments[]
  commission_records     commission_records[]
  promoter_links         promoter_links[]
  users                  users?                   @relation(fields: [userId], references: [id])
  user_referrals         user_referrals[]
  withdrawal_records     withdrawal_records[]
}

model resumes {
  id               String             @id @default(uuid())
  userId           String
  name             String
  fileUrl          String
  fileType         String
  fileSize         Int
  isDefault        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  job_applications job_applications[]
  users            users              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model search_queries {
  id           String   @id @default(uuid())
  query        String   @unique
  count        Int      @default(1)
  lastSearched DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([count])
  @@index([lastSearched])
}

model seo_plans {
  id               String           @id @default(uuid())
  monitorId        String
  pageType         String
  title            String
  h1               String
  metaDesc         String
  keywords         String[]
  outline          Json
  targetUrl        String?
  internalLinks    Json?
  contentMarkdown  String?
  status           String           @default("PENDING")
  generatedAt      DateTime         @default(now())
  generatedBy      String
  approvedAt       DateTime?
  approvedBy       String?
  publishedAt      DateTime?
  publishUrl       String?
  publishJobId     String?
  keyword_monitors keyword_monitors @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, pageType])
  @@index([publishedAt])
  @@index([status])
}

model seo_settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model sessions {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_profiles {
  id             String    @id @default(uuid())
  userId         String    @unique
  gender         String?
  birthday       DateTime?
  location       String?
  workExperience Json?
  education      Json?
  skills         String[]
  bio            String?
  updatedAt      DateTime  @updatedAt
  users          users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user_referrals {
  id             String         @id @default(uuid())
  userId         String         @unique
  promoterId     String
  linkId         String
  referralCode   String
  createdAt      DateTime       @default(now())
  promoter_links promoter_links @relation(fields: [linkId], references: [id], onDelete: Cascade)
  promoters      promoters      @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  users          users          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([promoterId])
  @@index([referralCode])
}

model users {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  name                    String
  password                String
  role                    UserRole                @default(USER)
  avatar                  String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  phone                   String?
  status                  UserStatus              @default(ACTIVE)
  balance                 Decimal                 @default(0.0) @db.Decimal(18, 8)
  ads                     ads[]
  balance_transactions    balance_transactions[]
  careerStories           CareerStory[]
  company_members         company_members[]
  contact_unlock_orders   contact_unlock_orders[]
  favorites               favorites[]
  job_applications        job_applications[]
  recommendationsReceived JobRecommendation[]     @relation("RecommendationsReceived")
  recommendationsSent     JobRecommendation[]     @relation("RecommendationsSent")
  jobSeekingStatus        JobSeekingStatus?
  jobs                    jobs[]
  notifications           notifications[]
  pages                   pages[]
  promoters               promoters?
  resumes                 resumes[]
  sessions                sessions[]
  storyComments           StoryComment[]
  gameProfile             UserGameProfile?
  UserJobPreferences      UserJobPreferences?
  user_profiles           user_profiles?
  user_referrals          user_referrals?
  notificationEmail       Boolean?                @default(true)
  notificationSms         Boolean?                @default(false)
  notificationPush        Boolean?                @default(false)
  resetToken              String?               @unique
  resetTokenExpires       DateTime?

  @@index([email])
}

model withdrawal_records {
  id            String           @id @default(uuid())
  promoterId    String
  amount        Decimal          @db.Decimal(18, 8)
  walletAddress String
  txHash        String?
  status        WithdrawalStatus @default(PENDING)
  remark        String?
  requestedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  completedAt   DateTime?
  promoters     promoters        @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@index([promoterId, status])
  @@index([status, requestedAt])
}

model CareerStory {
  id             String           @id @default(cuid())
  title          String
  content        String
  type           StoryType        @default(EXPERIENCE)
  timeline       Json?
  authorId       String
  companyId      String?
  viewCount      Int              @default(0)
  resonanceCount Int              @default(0)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  author         users            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company        companies?       @relation(fields: [companyId], references: [id])
  storyComments  StoryComment[]
  resonances     StoryResonance[]
  bookmarks      StoryBookmark[]

  @@index([authorId, createdAt])
  @@index([type, createdAt])
  @@index([isFeatured, createdAt])
  @@index([companyId, type, createdAt])
  @@map("career_stories")
}

model StoryResonance {
  id        String      @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime    @default(now())
  story     CareerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
  @@map("story_resonances")
}

model StoryBookmark {
  id        String      @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime    @default(now())
  story     CareerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId, createdAt])
  @@map("story_bookmarks")
}

model UserGameProfile {
  id            String            @id @default(cuid())
  userId        String            @unique
  level         Int               @default(1)
  exp           Int               @default(0)
  nextLevelExp  Int               @default(100)
  coins         Int               @default(100)
  title         String            @default("求职新人")
  stats         Json              @default("{\"offers\": 0, \"interviews\": 0, \"jobsViewed\": 0, \"jobsApplied\": 0}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastLoginAt   DateTime          @default(now())
  loginStreak   Int               @default(0)
  dailyCheckins DailyCheckin[]
  expLogs       ExpLog[]
  taskProgress  TaskProgress[]
  achievements  UserAchievement[]
  user          users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_game_profiles")
}

model Achievement {
  id               String              @id @default(cuid())
  code             String              @unique
  name             String
  description      String
  icon             String              @default("🏆")
  category         AchievementCategory @default(BASIC)
  expReward        Int                 @default(50)
  coinReward       Int                 @default(20)
  condition        Json
  isHidden         Boolean             @default(false)
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String          @id @default(cuid())
  profileId     String
  achievementId String
  unlockedAt    DateTime        @default(now())
  achievement   Achievement     @relation(fields: [achievementId], references: [id])
  profile       UserGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, achievementId])
  @@map("user_achievements")
}

model DailyCheckin {
  id            String          @id @default(cuid())
  profileId     String
  checkinDate   DateTime        @db.Date
  expReward     Int             @default(10)
  coinReward    Int             @default(10)
  isConsecutive Boolean         @default(false)
  createdAt     DateTime        @default(now())
  profile       UserGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, checkinDate])
  @@map("daily_checkins")
}

model TaskDefinition {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  description  String
  category     TaskCategory   @default(MAIN)
  type         String
  condition    Json
  expReward    Int            @default(10)
  coinReward   Int            @default(5)
  sortOrder    Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  taskProgress TaskProgress[]

  @@map("task_definitions")
}

model TaskProgress {
  id          String          @id @default(cuid())
  profileId   String
  taskId      String
  status      TaskStatus      @default(PENDING)
  progress    Int             @default(0)
  target      Int             @default(1)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  profile     UserGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  task        TaskDefinition  @relation(fields: [taskId], references: [id])

  @@unique([profileId, taskId])
  @@map("task_progress")
}

model ExpLog {
  id          String          @id @default(cuid())
  profileId   String
  amount      Int
  type        ExpType
  description String
  relatedId   String?
  createdAt   DateTime        @default(now())
  profile     UserGameProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("exp_logs")
}

model CompanyCultureTag {
  id        String    @id @default(cuid())
  companyId String
  tagName   String
  voteCount Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, tagName])
  @@index([companyId, voteCount])
  @@map("company_culture_tags")
}

model UserJobPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  cultureTags      String[]
  salaryMin        Int?
  salaryMax        Int?
  employmentTypes  String[]
  locations        String[]
  remotePreference String?
  experienceLevel  String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  user             users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_job_preferences")
}

model JobSeekingStatus {
  id             String               @id @default(cuid())
  userId         String               @unique
  status         JobSeekingStatusEnum @default(CLOSED)
  expectTags     String[]             @default([])
  expectSalary   String?
  bio            String?
  privacy        JobSeekingPrivacy    @default(CIRCLES)
  viewCount      Int                  @default(0)
  recommendCount Int                  @default(0)
  lastActiveAt   DateTime             @default(now())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, privacy])
  @@map("job_seeking_status")
}

model JobRecommendation {
  id          String               @id @default(cuid())
  senderId    String
  receiverId  String
  jobId       String
  storyId     String?
  status      RecommendationStatus @default(PENDING)
  message     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  respondedAt DateTime?
  job         jobs                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  receiver    users                @relation("RecommendationsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      users                @relation("RecommendationsSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId, jobId])
  @@index([receiverId, status])
  @@index([senderId, createdAt])
  @@map("job_recommendations")
}

model StoryComment {
  id        String      @id @default(cuid())
  storyId   String
  authorId  String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  author    users       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  story     CareerStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([authorId])
  @@map("story_comments")
}

